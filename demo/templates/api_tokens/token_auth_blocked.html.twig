{% extends 'base.html.twig' %}

{% block title %}API tokens — Clever Cloud Dashboard{% endblock %}
{% block page_title %}API tokens{% endblock %}

{% block body %}
    <div class="card card--warn">
        <div class="card__header"><h3 class="card__title">Indisponible dans ce mode</h3></div>
        <div class="card__body">
            <p>
                La gestion des tokens passe par <code class="code">api-bridge.clever-cloud.com</code>, qui n'accepte
                que l'authentification <strong>OAuth 1.0a</strong> : signer avec tes identifiants de consumer est
                précisément ce qui permet d'émettre un token Bearer. Tu es actuellement connecté avec un token
                Bearer, qui ne peut donc pas gérer les tokens : la passerelle répond
                <code class="code">400 must start with "OAuth "</code>.
            </p>
            <ol>
                <li>Crée un consumer OAuth 1.0a depuis la <a href="https://console.clever-cloud.com/" target="_blank" rel="noopener">Console Clever Cloud</a>.</li>
                <li>Déconnecte-toi puis reconnecte-toi via <em>OAuth</em>.</li>
            </ol>
            <div class="btn-group">
                <form class="inline" method="post" action="{{ path('logout') }}">
                    <button class="btn btn--primary" type="submit">Se déconnecter</button>
                </form>
                <a class="btn" href="{{ path('dashboard') }}">Retour à l'accueil</a>
            </div>
        </div>
    </div>
{% endblock %}
